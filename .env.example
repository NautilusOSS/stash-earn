# Privy — https://dashboard.privy.io
# Public app ID (safe for the browser)
VITE_PRIVY_APP_ID=

# Server-only — never expose in client code
PRIVY_APP_SECRET=

# Earn vault ID from Dashboard → Wallet infrastructure → Earn
# Set both: server uses PRIVY_VAULT_ID; client/UI uses VITE_PRIVY_VAULT_ID (same value).
PRIVY_VAULT_ID=
VITE_PRIVY_VAULT_ID=

# Show Privy ID and wallet address in Account → Settings (dev only)
VITE_DEBUG=false

# Voi mainnet algod/indexer (optional — defaults to nodely.dev endpoints)
VOI_ALGOD_SERVER=
VOI_ALGOD_PORT=
VOI_ALGOD_TOKEN=
VOI_INDEXER_SERVER=
VOI_INDEXER_PORT=
VOI_INDEXER_TOKEN=

# --- x402 payment gateway (server-only secrets) ---
# EVM settlement (Base USDC). Never use VITE_ prefix for these.
EVM_PRIVATE_KEY=
EVM_RECEIVER_ADDRESS=
EVM_RPC_URL=
EVM_CHAIN_ID=8453
USDC_CONTRACT_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913

# Algorand (future settlement/accounting — server-only)
ALGORAND_MNEMONIC=
ALGORAND_PRIVATE_KEY=
ALGORAND_NODE_URL=
ALGORAND_INDEXER_URL=

# x402 facilitator + defaults
X402_FACILITATOR_URL=https://x402.org/facilitator
X402_DEFAULT_USDC_AMOUNT=$0.01
# Optional: path for local replay-protection store (default .data/x402-replay-store.json)
X402_REPLAY_STORE_PATH=
