# Privy — https://dashboard.privy.io
# Public app ID (safe for the browser)
VITE_PRIVY_APP_ID=

# Server-only — never expose in client code
PRIVY_APP_SECRET=

# Optional: app authorization private key from Dashboard → Authorization keys.
# If unset, wallet actions are signed with an ephemeral user key from the access token.
PRIVY_AUTHORIZATION_PRIVATE_KEY=

# Earn vault ID from Dashboard → Wallet infrastructure → Earn
# Set both: server uses PRIVY_VAULT_ID; client/UI uses VITE_PRIVY_VAULT_ID (same value).
PRIVY_VAULT_ID=
VITE_PRIVY_VAULT_ID=

# Show Privy ID and wallet address in Account → Settings (dev only)
VITE_DEBUG=false

# Dev: add your dev origin in Privy Dashboard → Configuration → App settings → Allowed domains
# (e.g. http://localhost:8081). Blink deposits should use MetaMask in Blink, not Base Account.

# Blink deposit (production / Base mainnet) — https://docs.blink.cash/introduction
#
# Setup (one-time):
#   1. Generate an ECDSA P-256 key pair (keep private.pem secret):
#      openssl ecparam -name prime256v1 -genkey -noout | openssl pkcs8 -topk8 -nocrypt -out private.pem
#      openssl ec -in private.pem -pubout -out public.pem
#   2. Register with Blink production API and copy merchantId from the 202 response:
#      curl -X POST https://api.blink.cash/v1/merchants/applications \
#        -H 'Content-Type: application/json' \
#        -d '{"email":"you@example.com","domain":"yourapp.com","publicKey":"$(cat public.pem | jq -Rs .)","description":"..."}'
#   Testnet sandbox (Base Sepolia only): POST https://api-sandbox.blink.cash/v1/merchants/applications
#   then set VITE_BLINK_ENVIRONMENT=sandbox and BLINK_ENVIRONMENT=sandbox
#
# Required for Blink deposits:
#   VITE_BLINK_MERCHANT_ID — merchant UUID (safe in browser; SDK needs it)
#   BLINK_MERCHANT_PRIVATE_KEY — PKCS#8 PEM private key (server-only; never VITE_)
#
# Optional:
#   BLINK_MERCHANT_ID — duplicate of VITE_BLINK_MERCHANT_ID if server cannot read VITE_ vars
#   BLINK_ENVIRONMENT / VITE_BLINK_ENVIRONMENT — omit for production (Base 8453); sandbox for testnet
#
# PEM in .env: use escaped newlines on one line, or wrap in double quotes:
#   BLINK_MERCHANT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIGH...\n-----END PRIVATE KEY-----"
VITE_BLINK_MERCHANT_ID=
BLINK_MERCHANT_PRIVATE_KEY=
# BLINK_MERCHANT_ID=
# VITE_BLINK_ENVIRONMENT=sandbox

# Dynamic Fireblocks Flow — https://www.dynamic.xyz/docs/overview/fireblocks-flow-api
# Create a deposit-mode checkout in Dynamic dashboard (settles to Base USDC).
# VITE_ vars are safe in the browser; DYNAMIC_API_TOKEN is server-only (checkout admin).
VITE_DYNAMIC_ENVIRONMENT_ID=
VITE_DYNAMIC_CHECKOUT_ID=
# DYNAMIC_ENVIRONMENT_ID=
# DYNAMIC_CHECKOUT_ID=
# DYNAMIC_API_TOKEN=

# Voi mainnet algod/indexer (optional — defaults to nodely.dev endpoints)
VOI_ALGOD_SERVER=
VOI_ALGOD_PORT=
VOI_ALGOD_TOKEN=
VOI_INDEXER_SERVER=
VOI_INDEXER_PORT=
VOI_INDEXER_TOKEN=

# --- x402 payment gateway (server-only secrets) ---
# EVM settlement (Base USDC). Never use VITE_ prefix for these.
EVM_PRIVATE_KEY=
EVM_RECEIVER_ADDRESS=
EVM_RPC_URL=
EVM_CHAIN_ID=8453
USDC_CONTRACT_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913

# Algorand (future settlement/accounting — server-only)
ALGORAND_MNEMONIC=
ALGORAND_PRIVATE_KEY=
ALGORAND_NODE_URL=
ALGORAND_INDEXER_URL=

# x402 facilitator + defaults
X402_FACILITATOR_URL=https://x402.org/facilitator
X402_DEFAULT_USDC_AMOUNT=$0.01
# Optional: path for local replay-protection store (default .data/x402-replay-store.json)
X402_REPLAY_STORE_PATH=
