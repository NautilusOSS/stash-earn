# Privy — https://dashboard.privy.io
# Public app ID (safe for the browser)
VITE_PRIVY_APP_ID=

# Server-only — never expose in client code
PRIVY_APP_SECRET=

# Earn vault ID from Dashboard → Wallet infrastructure → Earn
# Optional until deposit/withdraw flows are wired up
PRIVY_VAULT_ID=
VITE_PRIVY_VAULT_ID=

# Show Privy ID and wallet address in Account → Settings (dev only)
VITE_DEBUG=false

# Voi mainnet algod/indexer (optional — defaults to nodely.dev endpoints)
VOI_ALGOD_SERVER=
VOI_ALGOD_PORT=
VOI_ALGOD_TOKEN=
VOI_INDEXER_SERVER=
VOI_INDEXER_PORT=
VOI_INDEXER_TOKEN=
